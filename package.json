{
  "name": "trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Bot de trading automatizado com paper trading, backtest, gestão de risco e painel web",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "node --watch src/server/server.js",
    "dev:bot": "node --watch src/bot/main.js",
    "start:bot": "node src/bot/main.js",
    "start:dashboard": "node src/server/server.js",
    "test": "node --test --test-concurrency=1 test/",
    "backtest": "node src/cli/backtest.js",
    "bot:paper": "TRADING_MODE=paper node src/bot/main.js",
    "bot:live": "TRADING_MODE=live node src/bot/main.js",
    "bot:status": "node src/cli/status.js",
    "bot:stop": "node src/cli/stop.js",
    "user:create": "node src/cli/createUser.js",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "user:delete": "node src/cli/deleteUser.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.0.0",
    "dotenv": "^17.0.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.0",
    "express-session": "^1.19.0",
    "helmet": "^8.1.0",
    "ws": "^8.18.0",
    "zod": "^4.0.0"
  }
}
