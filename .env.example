# =====================================================================
# TRADING BOT — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o .env (já está no .gitignore).
# Todos os valores de risco abaixo são EXEMPLOS CONSERVADORES para o teste
# de R$20 — não são recomendação de investimento. Ajuste conscientemente.
# =====================================================================

NODE_ENV=development
TIMEZONE=America/Sao_Paulo

# ---- Modo de operação -------------------------------------------------
# paper = só simulação (padrão). live = permite a conta real.
TRADING_MODE=paper
# Kill switch global. false = nenhuma ordem é enviada (nem paper).
TRADING_ENABLED=false
# Live só funciona se TRADING_MODE=live E esta flag for true.
LIVE_TRADING_CONFIRM=false

# ---- Corretora (conta LIVE) ----------------------------------------------
# Mercado Bitcoin API v4 (https://api.mercadobitcoin.net/api/v4/docs)
# Crie a chave SEM permissão de saque. API_KEY = client_id, API_SECRET = client_secret.
BROKER=mercadobitcoin
API_KEY=
API_SECRET=
API_BASE_URL=https://api.mercadobitcoin.net/api/v4
# Opcional: id da conta no MB (se vazio, usa a primeira conta retornada por /accounts)
BROKER_ACCOUNT_ID=

# ---- Ativo / estratégia (valores iniciais; editáveis no painel) ------------
SYMBOL=BTC-BRL
TIMEFRAME=15m
STRATEGY=ema_rsi

# ---- Capital -----------------------------------------------------------
# Capital inicial da conta PAPER (em R$). A conta LIVE usa o saldo real.
INITIAL_CAPITAL=20

# ---- Risco (editáveis no painel, com confirmação) --------------------------
# % máximo do patrimônio alocado em posição (100 = pode usar todo o saldo)
MAX_POSITION_PERCENT=95
# Valor máximo por ordem em R$
MAX_ORDER_VALUE=20
# Perda máxima no dia em R$ (atingiu -> TRADING HALTED até o próximo dia)
MAX_DAILY_LOSS=1
# Máximo de ENTRADAS por dia
MAX_DAILY_TRADES=4
STOP_LOSS_PERCENT=2
TAKE_PROFIT_PERCENT=3
# Spread máximo aceito (%) entre bid e ask
MAX_SPREAD_PERCENT=0.5
# Volume mínimo negociado em 24h no ativo (em R$) para considerar líquido
MIN_24H_VOLUME=100000
# Ao PARAR o bot: true = continua gerenciando stop/take da posição aberta
STOP_MANAGE_EXITS=true

# ---- Paper trading ----------------------------------------------------------
# Taxa simulada por execução (%). 0.70 = taker de exemplo da doc do MB.
PAPER_FEE_PERCENT=0.70
# Slippage simulado (%) além do bid/ask
PAPER_SLIPPAGE_PERCENT=0.05

# ---- Sistema -----------------------------------------------------------------
# Verificação de preço / stop / take (segundos)
PRICE_CHECK_INTERVAL_SECONDS=15
# Reconciliação banco x corretora (segundos)
RECONCILE_INTERVAL_SECONDS=300
# Dados considerados velhos após (segundos) -> não opera
MAX_DATA_AGE_SECONDS=90

# ---- Banco -------------------------------------------------------------------
# SQLite. Caminho relativo à raiz do projeto.
DATABASE_URL=file:./data/trading.db

# ---- Painel ----------------------------------------------------------------
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3010
# Segredo da sessão (gere com: openssl rand -hex 32)
JWT_SECRET=
# true quando o painel estiver atrás de HTTPS
COOKIE_SECURE=false
# Chave do cofre que cifra credenciais cadastradas no painel (ex.: XP MT5).
# Gere com: openssl rand -hex 32   — se perder, será preciso recadastrar.
CREDENTIALS_KEY=
